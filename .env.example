# Copy this file to .env and keep the real .env untracked.
# Every filesystem location below is relative to the project root.
CELLTYPIST_FOLDER=./data/celltypist
CELLPILOT_DATA_DIR=./data
CELLPILOT_RESULTS_DIR=./results
CELLPILOT_CONFIG=./configs/pbmc3k.yaml

# Keep third-party caches inside the workspace.
XDG_CACHE_HOME=./work/cache
MPLCONFIGDIR=./work/cache/matplotlib
NUMBA_CACHE_DIR=./work/cache/numba

# Optional AI interpretation. Leave unset for the deterministic workflow.
OPENAI_API_KEY=
CELLPILOT_OPENAI_MODEL=
